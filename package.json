{
  "name": "daily-todos",
  "private": true,
  "version": "1.0.0-beta.1",
  "description": "A lightweight cross-platform desktop todo and habit tracker with floating widgets.",
  "license": "MIT",
  "repository": "https://github.com/Xusq513/daily-todos",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
