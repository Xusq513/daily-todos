    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@types/canvas-confetti": "^1.9.0",
    "autoprefixer": "^10.5.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.39.0",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.0"
  }
